{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>accelerate-toolkit/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "RENOVATE_IMAGE := (?<depName>[^\\s]+):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^actions/renovate/action.yml$/"
      ],
      "matchStrings": [
        "renovate-version:\\n    description: Exact Renovate version\\n    default: (?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "ACTIONLINT_VERSION := (?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "rhysd/actionlint",
      "datasourceTemplate": "github-releases"
    }
  ],
  "automerge": true,
  "platformAutomerge": false,
  "ignoreTests": false,
  "timezone": "Europe/London",
  "schedule": [
    "before 6am on monday"
  ]
}
