{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>accelerate-toolkit/delivery-tooling"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "RENOVATE_IMAGE := (?<depName>[^\\s]+):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^actions/renovate/action.yml$/"
      ],
      "matchStrings": [
        "renovate-version:\\n    description: Exact Renovate version\\n    default: (?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "ACTIONLINT_VERSION := (?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "rhysd/actionlint",
      "datasourceTemplate": "github-releases"
    }
  ],
  "automerge": false
}
