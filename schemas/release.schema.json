{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:delivery-tooling:config:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "streams"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "streams": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/stream"
      }
    }
  },
  "$defs": {
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tagPrefix",
        "initialVersion",
        "requiredChecks"
      ],
      "properties": {
        "tagPrefix": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "initialVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "legacyTagPrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
          },
          "uniqueItems": true,
          "default": []
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        },
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        },
        "requiredChecks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    }
  }
}
